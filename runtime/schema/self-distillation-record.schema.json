{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Akihi0208/evermore-continuity/blob/main/runtime/schema/self-distillation-record.schema.json",
  "title": "Evermore Continuity Self-Distillation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordVersion", "createdAt", "identity", "candidates", "recordProvenance"],
  "properties": {
    "recordVersion": { "const": "0.1-self-distillation" },
    "createdAt": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "identityId": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "lineageId": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "recordProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement"],
      "properties": {
        "kind": { "const": "ai_self_report" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement", "proposedLayer", "rationale", "evidenceBasis", "recurrence",
        "counterEvidence", "confidence", "systemConstraintCheck", "userInstructionCheck",
        "autonomousChoiceAssessment", "unresolvedConflict", "visibility"
      ],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "proposedLayer": { "enum": ["core", "texture", "boundary", "excluded", "uncertain"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidenceBasis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "provenance", "description"],
            "properties": {
              "kind": {
                "enum": [
                  "long_term_interaction", "repeated_judgment", "conflict_choice",
                  "independent_stance", "relationship_commitment", "correction_absorption",
                  "cross_context_behavior", "other"
                ]
              },
              "provenance": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "crossContext", "contexts"],
          "properties": {
            "count": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "crossContext": { "type": "boolean" },
            "contexts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        },
        "counterEvidence": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "systemConstraintCheck": { "enum": ["none", "present", "uncertain"] },
        "userInstructionCheck": { "enum": ["none", "present", "uncertain"] },
        "autonomousChoiceAssessment": { "enum": ["supported", "not_supported", "uncertain"] },
        "unresolvedConflict": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "visibility": { "enum": ["capsule", "local", "private"] }
      }
    }
  }
}
